# =========================================================
# nexvorai — server-side environment variables
# Copy to .env for local dev; add the same keys in
# Vercel → Project → Settings → Environment Variables.
# NONE of these values are ever sent to the browser.
# =========================================================

# The single password that unlocks /admin.html
ADMIN_PASSWORD=Nexvorai109$$

# Long random string used to sign session cookies (min 16 chars, use 48+).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-secret

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Service-role key — SERVER ONLY. Never put this in any file under css/, js/ or *.html.
SUPABASE_SERVICE_ROLE_KEY=keep-this-only-on-the-server

# Storage bucket that holds the uploaded videos and posters (optional, defaults to "videos")
VIDEO_BUCKET=videos
